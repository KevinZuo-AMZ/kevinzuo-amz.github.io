# GitHub Personal Access Token，实际值只放本机 .env 或系统环境变量。
GITHUB_TOKEN=

# 可选：源 Excel 文件目录。Windows 自动化可继续使用脚本内的默认路径。
AMZ_SOURCE_DIR=

# 领星 ERP：设置 -> 业务配置 -> 全局 -> 开放接口。
# 真实值只写入本机 .env；不要粘贴到聊天、普通文档或 Git。
LINGXING_APP_ID=
LINGXING_APP_SECRET=

# 可选：逗号分隔店铺 sid。留空时同步全部状态正常的授权店铺。
LINGXING_SIDS=

# 产品表现默认回看 90 天，并统一换算为 USD。
LINGXING_LOOKBACK_DAYS=90
LINGXING_CURRENCY_CODE=USD

# 通常无需修改。
LINGXING_BASE_URL=https://openapi.lingxing.com
LINGXING_TIMEOUT_SECONDS=60

# 看板内“领星 API 接入”模块使用的本机连接器。连接器仅监听回环地址。
LINGXING_BRIDGE_HOST=127.0.0.1
LINGXING_BRIDGE_PORT=8765
LINGXING_BRIDGE_SYNC_TIMEOUT=1800
LINGXING_BRIDGE_PUBLISH_TIMEOUT=300
